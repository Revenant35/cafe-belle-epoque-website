---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const allEvents = await getCollection('events');

const now = new Date();
now.setHours(0, 0, 0, 0);

const upcoming = allEvents
  .filter(e => new Date(e.data.date) >= now && !e.data.cancelled)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const past = allEvents
  .filter(e => new Date(e.data.date) < now && !e.data.cancelled)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const fmt = (date: Date) =>
  date.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
---

<Layout title="Events — Cafe Belle Epoque">
  <div class="events-page">

    <header class="page-header">
      <p class="page-label">The Belle Epoque Cafe</p>
      <h1 class="page-title">Events</h1>
      <div class="page-rule" aria-hidden="true">
        <span class="page-rule__line"></span>
        <span class="page-rule__diamond"></span>
        <span class="page-rule__line"></span>
      </div>
    </header>

    {upcoming.length > 0 ? (
      <section class="events-section">
        <ul class="events-list">
          {upcoming.map(async event => {
            const { Content } = await render(event);
            return (
              <li class="event-card">
                <div class="event-card__date">
                  <span class="event-card__day">
                    {new Date(event.data.date).toLocaleDateString('en-US', { timeZone: 'UTC', day: 'numeric' })}
                  </span>
                  <span class="event-card__month">
                    {new Date(event.data.date).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short' })}
                  </span>
                </div>
                <div class="event-card__body">
                  <h2 class="event-card__title">{event.data.title}</h2>
                  <p class="event-card__meta">
                    {fmt(new Date(event.data.date))} &nbsp;&middot;&nbsp; {event.data.time}
                    {event.data.location && <span> &nbsp;&middot;&nbsp; {event.data.location}</span>}
                    {event.data.price && <span> &nbsp;&middot;&nbsp; {event.data.price}</span>}
                  </p>
                  <div class="event-card__content">
                    <Content />
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    ) : (
      <section class="events-empty">
        <p>No upcoming events at this time. Check back soon, or follow us on Facebook for the latest announcements.</p>
      </section>
    )}

    {past.length > 0 && (
      <section class="events-section events-section--past">
        <div class="past-heading-rule" aria-hidden="true">
          <span class="past-heading-rule__line"></span>
          <span class="past-heading-rule__label">Past Events</span>
          <span class="past-heading-rule__line"></span>
        </div>
        <ul class="events-list events-list--past">
          {past.map(async event => {
            const { Content } = await render(event);
            return (
              <li class="event-card event-card--past">
                <div class="event-card__date">
                  <span class="event-card__day">
                    {new Date(event.data.date).toLocaleDateString('en-US', { timeZone: 'UTC', day: 'numeric' })}
                  </span>
                  <span class="event-card__month">
                    {new Date(event.data.date).toLocaleDateString('en-US', { timeZone: 'UTC', month: 'short' })}
                  </span>
                </div>
                <div class="event-card__body">
                  <h3 class="event-card__title">{event.data.title}</h3>
                  <p class="event-card__meta">
                    {fmt(new Date(event.data.date))} &nbsp;&middot;&nbsp; {event.data.time}
                    {event.data.location && <span> &nbsp;&middot;&nbsp; {event.data.location}</span>}
                    {event.data.price && <span> &nbsp;&middot;&nbsp; {event.data.price}</span>}
                  </p>
                  <div class="event-card__content">
                    <Content />
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}

  </div>
</Layout>

<style>
  .events-page {
    max-width: 860px;
    margin: 0 auto;
    padding: var(--space-xl) var(--space-lg) var(--space-2xl);
  }

  /* ── Page Header ──────────────────────────────────────── */

  .page-header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .page-label {
    font-family: var(--font-label);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .page-title {
    font: var(--text-h1);
    color: var(--color-purple);
    margin-bottom: var(--space-md);
  }

  .page-rule {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    max-width: 320px;
    margin: 0 auto;
  }

  .page-rule__line {
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .page-rule__diamond {
    width: 6px;
    height: 6px;
    background-color: var(--color-gold);
    transform: rotate(45deg);
    flex-shrink: 0;
  }

  /* ── Events List ──────────────────────────────────────── */

  .events-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* ── Event Card ───────────────────────────────────────── */

  .event-card {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: var(--space-lg);
    padding: var(--space-lg);
    background-color: var(--color-surface);
    border-left: 2px solid var(--color-purple);
  }

  .event-card--past {
    border-left-color: var(--color-border);
    background-color: transparent;
  }

  .event-card--past .event-card__title {
    color: var(--color-text-muted);
  }

  /* ── Date Badge ───────────────────────────────────────── */

  .event-card__date {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding-top: 0.2rem;
    gap: 0.1rem;
  }

  .event-card__day {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 300;
    line-height: 1;
    color: var(--color-purple);
  }

  .event-card--past .event-card__day {
    color: var(--color-text-muted);
  }

  .event-card__month {
    font-family: var(--font-label);
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* ── Card Body ────────────────────────────────────────── */

  .event-card__title {
    font: var(--text-h3);
    color: var(--color-text);
    margin-bottom: var(--space-xs);
  }

  .event-card__meta {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: var(--space-sm);
  }

  .event-card__content {
    font: var(--text-body);
    color: var(--color-text-muted);
  }

  .event-card__content p {
    margin-bottom: var(--space-sm);
  }

  .event-card__description {
    font: var(--text-caption);
    color: var(--color-text-muted);
  }

  /* ── Past Section ─────────────────────────────────────── */

  .events-section--past {
    margin-top: var(--space-xl);
  }

  .past-heading-rule {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .past-heading-rule__line {
    flex: 1;
    height: 1px;
    background-color: var(--color-border);
  }

  .past-heading-rule__label {
    font-family: var(--font-label);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ── Empty State ──────────────────────────────────────── */

  .events-empty {
    text-align: center;
    padding: var(--space-xl) 0;
  }

  .events-empty p {
    font: var(--text-caption);
    color: var(--color-text-muted);
    max-width: none;
    margin: 0 auto;
  }

  /* ── Mobile ───────────────────────────────────────────── */

  @media (max-width: 600px) {
    .event-card {
      grid-template-columns: 3rem 1fr;
      gap: var(--space-md);
      padding: var(--space-md);
    }

    .event-card__day {
      font-size: 1.6rem;
    }
  }
</style>
