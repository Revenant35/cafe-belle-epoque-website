---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Cafe Belle Epoque — Downtown St. Joseph">
  <section class="placeholder">
    <h1>Belle Epoque</h1>
    <p>A classical French cafe in the heart of downtown St. Joseph.</p>
  </section>
</Layout>

<style>
  .placeholder {
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--space-xl);
    text-align: center;
  }

  .placeholder h1 {
    font: var(--text-display);
    color: var(--color-purple);
    margin-bottom: var(--space-md);
  }

  .placeholder p {
    font: var(--text-caption);
    color: var(--color-text-muted);
    margin: 0 auto;
  }
</style>
